# ==========================================================
# SkillPilot — Frontend Environment Variables (.env)
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==========================================================

# Required: Gemini AI API key (for AI summary enhancement in server.ts)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional: The URL where this app is hosted (used for OAuth callbacks etc.)
APP_URL="http://localhost:3000"
