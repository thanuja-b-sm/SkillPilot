# ==========================================================
# SkillPilot — Backend Environment Variables (.env)
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==========================================================

# ---------- Database ------------------------------------------
# JDBC URL for MySQL. The ?createDatabaseIfNotExist=true param
# will auto-create the 'skillpilot' database on first run.
DB_URL=jdbc:mysql://localhost:3306/skillpilot?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL credentials
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# ---------- JWT Security --------------------------------------
# A long, random secret used to sign JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET_HERE

# Token expiry duration in milliseconds (default: 24 hours)
JWT_EXPIRATION_MS=86400000

# ---------- Gemini AI -----------------------------------------
# Required for the Spring Boot Gemini integration.
# Obtain at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---------- CORS ----------------------------------------------
# The origin URL of the frontend (Node/Vite dev server)
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Server --------------------------------------------
PORT=8080
